{
  "manifest_version": 3,
  "name": "EmlakRadar Scraper",
  "version": "1.1.0",
  "description": "Çanakkale emlak ilanlarını otomatik toplar.",

  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage"
  ],

  "host_permissions": [
    "https://www.sahibinden.com/*",
    "https://www.hepsiemlak.com/*",
    "https://www.emlakjet.com/*",
    "https://hetagayrimenkul.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "EmlakRadar Scraper"
  }
}
