{
  "manifest_version": 3,
  "name": "EmlakRadar Scraper",
  "version": "2.0.0",
  "description": "Emlak ilanlarını otomatik toplar — Sahibinden, Hepsiemlak, Emlakjet",

  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage",
    "debugger",
    "cookies",
    "notifications"
  ],

  "host_permissions": [
    "https://www.sahibinden.com/*",
    "https://secure.sahibinden.com/*",
    "https://*.sahibinden.com/*",
    "https://www.hepsiemlak.com/*",
    "https://www.emlakjet.com/*",
    "https://hetagayrimenkul.com/*",
    "https://api.capmonster.cloud/*",
    "https://api.capsolver.com/*",
    "https://api.2captcha.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "EmlakRadar Scraper",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
