# ─── cPanel Panel API ─────────────────────────────────────────────────────────
CPANEL_API_URL=https://panel.emlakradar.com/api
CPANEL_WEBHOOK_SECRET=guclu-bir-secret-key-buraya-min-32-karakter
CPANEL_API_TOKEN=

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── WebSocket ────────────────────────────────────────────────────────────────
WEBSOCKET_PORT=3001
WEBSOCKET_CORS_ORIGIN=https://panel.emlakradar.com

# ─── Scraper Ayarları ─────────────────────────────────────────────────────────
SCRAPE_INTERVAL_MINUTES=10
SCRAPE_CITIES=kocaeli,istanbul,ankara,izmir
SCRAPE_MAX_PAGES=5
SCRAPE_DELAY_MIN=3000
SCRAPE_DELAY_MAX=10000

# ─── Proxy Havuzu (opsiyonel) ─────────────────────────────────────────────────
# Virgülle ayrılmış proxy listesi:
# socks5://user:pass@ip:port,http://user:pass@ip:port
PROXY_LIST=

# ─── Loglama ──────────────────────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info

# ─── Ghost Tracker ────────────────────────────────────────────────────────────
GHOST_CHECK_INTERVAL_HOURS=6
GHOST_BATCH_SIZE=50
